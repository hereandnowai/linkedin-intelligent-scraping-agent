# Example .env Configuration
# Copy this to .env and customize

# =====================================
# LinkedIn Credentials
# =====================================
# Optional - If not provided, you'll be prompted at runtime
LINKEDIN_EMAIL=your-email@example.com
LINKEDIN_PASSWORD=your-secure-password

# =====================================
# OpenAI Configuration
# =====================================
# Optional - Enables AI-powered data extraction and normalization
# Without this, basic extraction will be used
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# =====================================
# Rate Limiting Settings
# =====================================
# Adjust these to control scraping speed and reduce detection risk

# Minimum delay between actions (seconds)
# Lower = faster but higher detection risk
MIN_DELAY_SECONDS=3

# Maximum delay between actions (seconds)
# Higher = slower but more human-like
MAX_DELAY_SECONDS=7

# Maximum profiles to scrape per session
# Stay under 50 to avoid account flags
MAX_PROFILES_PER_SESSION=50

# =====================================
# Browser Settings
# =====================================
# Run in headless mode (no browser window)
# Set to False to see the browser in action
HEADLESS=False

# =====================================
# Data Fields
# =====================================
# These are defined in config.py
# Edit config.py to customize which fields to extract

# =====================================
# Usage Examples
# =====================================
# Conservative (safest):
#   MIN_DELAY_SECONDS=5
#   MAX_DELAY_SECONDS=10
#   MAX_PROFILES_PER_SESSION=20
#
# Moderate (balanced):
#   MIN_DELAY_SECONDS=3
#   MAX_DELAY_SECONDS=7
#   MAX_PROFILES_PER_SESSION=50
#
# Aggressive (higher risk):
#   MIN_DELAY_SECONDS=2
#   MAX_DELAY_SECONDS=4
#   MAX_PROFILES_PER_SESSION=100
#
# Recommended: Start conservative, adjust based on results
